; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mieu"
run/main_scene="uid://cghgofk26acco"
config/use_custom_user_dir=true
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://d2wsv05a3y641"
config/icon="res://current/assets/images/mieu_splash.png"
boot_splash/minimum_display_time=1250

[autoload]

Ui="*res://current/scripts/globals/autoloads/ui.gd"
GlobalVars="*res://current/scripts/globals/autoloads/global_vars.gd"
Vpet="*res://current/scripts/globals/autoloads/vpet.gd"
Saves="*res://current/scripts/globals/autoloads/saves.gd"
SignalBus="*res://current/scripts/globals/autoloads/signal_bus.gd"
Multithreading="*res://current/scripts/globals/autoloads/multithreading.gd"
SteamWorks="*res://current/scripts/globals/autoloads/networking/steam.gd"
SteamLobbies="*res://current/scripts/globals/autoloads/networking/steam_lobbies.gd"
SteamP2P="*res://current/scripts/globals/autoloads/networking/steam_p2p.gd"
ChatFilter="*res://current/scripts/globals/autoloads/networking/chat_filter.gd"
WorldManager="*res://current/scripts/globals/autoloads/world_manager.gd"
Moderation="*res://current/scripts/globals/autoloads/networking/moderation.gd"
MinigameManager="*res://current/scripts/globals/autoloads/minigame_manager.gd"
Cryptography="*res://current/scripts/globals/autoloads/networking/cryptography.gd"
StabilityMitigator="*res://current/scripts/globals/autoloads/networking/stability_mitigator.gd"

[compression]

formats/gzip/compression_level=9

[debug]

file_logging/enable_file_logging.pc=false
gdscript/warnings/unused_signal=0
gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/subwindows/embed_subwindows=false
window/stretch/mode="viewport"
window/per_pixel_transparency/allowed=true
mouse_cursor/custom_image="res://current/assets/ui/cursorMono.png"
mouse_cursor/tooltip_position_offset=Vector2(0, 0)

[gui]

theme/custom_font="res://current/assets/fonts/AtkinsonHyperlegible-Regular.ttf"

